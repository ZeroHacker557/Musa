# bot/.env uchun namuna. Nusxa oling va qiymatni to'ldiring:
#   cp bot/.env.example bot/.env
#
# BOT_TOKEN — @BotFather dan olinadi. Bu token initData imzosini
# tekshiradi, ya'ni butun autentifikatsiyaning kaliti. Sizib chiqsa,
# istalgan odam istalgan foydalanuvchi nomidan kira oladi.
BOT_TOKEN=

# Linko katalogini kun davomida sinxronlash uchun — Vercel'dagi
# CRON_SECRET bilan BIR XIL bo'lsin. Bo'sh qoldirilsa, bot sinxronni
# chaqirmaydi (Vercel'dagi kunlik cron baribir ishlayveradi).
CRON_SECRET=
